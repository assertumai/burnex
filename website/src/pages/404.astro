---
// 404 в общей раскладке Starlight (без переопределения компонентов), с маскотом.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import mark from '../assets/brand/burnex-mark.svg?raw';

// Маскот встраивается разметкой, чтобы CSS погасил слои .bx-crack и .bx-eyes.
const out = `<div class="bx-out">${mark.replace('aria-label="burnex"', 'aria-hidden="true"')}</div>`;

// GitHub Pages отдаёт один 404.html на весь сайт — он на языке по умолчанию,
// с кнопкой русской главной.
const home = `${import.meta.env.BASE_URL}en/`;
---

<StarlightPage
	frontmatter={{
		title: 'Page not found',
		template: 'splash',
		pagefind: false,
		editUrl: false,
		hero: {
			title: 'Nothing is burning here',
			tagline: 'This page does not exist — it may have moved to the Reference or been renamed.',
			image: { html: out },
			actions: [
				{ text: 'Home', link: home, variant: 'primary' },
				{ text: 'First run', link: `${home}start/first-run/`, variant: 'minimal' },
				{ text: 'Русская версия', link: `${import.meta.env.BASE_URL}ru/`, variant: 'minimal' },
			],
		},
	}}
/>
