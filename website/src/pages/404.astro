---
// 404 в общей раскладке Starlight (без переопределения компонентов), с маскотом.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import mark from '../assets/brand/burnex-mark.svg?raw';

// Маскот встраивается разметкой, чтобы CSS погасил слои .bx-crack и .bx-eyes.
const out = `<div class="bx-out">${mark.replace('aria-label="burnex"', 'aria-hidden="true"')}</div>`;

const home = `${import.meta.env.BASE_URL}ru/`;
---

<StarlightPage
	frontmatter={{
		title: 'Страница не найдена',
		template: 'splash',
		pagefind: false,
		editUrl: false,
		hero: {
			title: 'Тут ничего не горит',
			tagline: 'Такой страницы нет — возможно, она переехала в «Справочник» или была переименована.',
			image: { html: out },
			actions: [
				{ text: 'На главную', link: home, variant: 'primary' },
				{ text: 'Первый прогон', link: `${home}start/first-run/`, variant: 'minimal' },
			],
		},
	}}
/>
