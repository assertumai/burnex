{
  "title": "burnex review strategy",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "review-strategy"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "description": {
      "type": "string"
    },
    "profiles": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "backend": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "model_tier": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "effort": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "context": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "mode": {
                      "type": "string",
                      "enum": [
                        "inline",
                        "reference",
                        "auto"
                      ]
                    },
                    "required": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "path"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "item_refs": {
                      "type": "string"
                    },
                    "mode": {
                      "type": "string",
                      "enum": [
                        "inline",
                        "reference",
                        "auto"
                      ]
                    }
                  },
                  "required": [
                    "item_refs"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "knowledge": {
                      "anyOf": [
                        {
                          "type": "string",
                          "const": "index"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "scope": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "array",
                                  "items": {
                                    "type": "string"
                                  }
                                }
                              ]
                            },
                            "id": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "array",
                                  "items": {
                                    "type": "string"
                                  }
                                }
                              ]
                            },
                            "budget": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "number"
                                }
                              ]
                            }
                          },
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "required": [
                    "knowledge"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "backend"
        ],
        "additionalProperties": false,
        "not": {
          "required": [
            "model",
            "model_tier"
          ]
        }
      }
    },
    "reviewers": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "agent": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "model_tier": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "effort": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "focus": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "not": {
          "required": [
            "model",
            "model_tier"
          ]
        }
      }
    },
    "aggregator": {
      "type": "object",
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "model_tier": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "effort": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "prompt": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "not": {
        "required": [
          "model",
          "model_tier"
        ]
      }
    },
    "mode": {
      "type": "string",
      "enum": [
        "independent",
        "discussion"
      ]
    },
    "discussion": {
      "type": "object",
      "properties": {
        "max_messages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": [
        "max_messages"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "kind",
    "name",
    "reviewers"
  ],
  "additionalProperties": false,
  "if": {
    "properties": {
      "mode": {
        "const": "discussion"
      }
    },
    "required": [
      "mode"
    ]
  },
  "then": {
    "required": [
      "discussion"
    ],
    "properties": {
      "reviewers": {
        "minItems": 2
      }
    }
  },
  "else": {
    "not": {
      "required": [
        "discussion"
      ]
    }
  }
}
