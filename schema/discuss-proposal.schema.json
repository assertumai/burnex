{
  "title": "burnex discuss proposal",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "approach": {
      "type": "string"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "choice": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        },
        "required": [
          "question",
          "choice",
          "rationale"
        ],
        "additionalProperties": false
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diagrams": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "mermaid"
            ]
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "kind",
          "source"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "summary",
    "approach",
    "decisions",
    "risks",
    "diagrams"
  ],
  "additionalProperties": false
}
