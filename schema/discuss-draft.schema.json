{
  "title": "burnex discuss draft",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^d[1-9][0-9]*$"
          },
          "question": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "by": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                }
              },
              "required": [
                "by",
                "summary"
              ],
              "additionalProperties": false
            }
          },
          "choice": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "question",
          "options",
          "choice",
          "rationale"
        ],
        "additionalProperties": false
      }
    },
    "diagrams": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^g[1-9][0-9]*$"
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "mermaid"
            ]
          },
          "source": {
            "type": "string"
          },
          "decisions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^d[1-9][0-9]*$"
            }
          }
        },
        "required": [
          "id",
          "title",
          "kind",
          "source",
          "decisions"
        ],
        "additionalProperties": false
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "risk": {
            "type": "string"
          },
          "mitigation": {
            "type": "string"
          }
        },
        "required": [
          "risk",
          "mitigation"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "summary",
    "decisions",
    "diagrams",
    "risks"
  ],
  "additionalProperties": false
}
