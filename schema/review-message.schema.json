{
  "title": "burnex review discussion message",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "text": { "type": "string" },
    "stance": { "type": "string", "enum": ["propose", "agree", "disagree"] },
    "proposal": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "summary": { "type": "string" },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "severity": { "type": "string", "enum": ["critical", "major", "minor", "info"] },
                  "title": { "type": "string" },
                  "location": { "type": ["string", "null"] },
                  "detail": { "type": "string" },
                  "suggestion": { "type": ["string", "null"] }
                },
                "required": ["severity", "title", "location", "detail", "suggestion"],
                "additionalProperties": false
              }
            }
          },
          "required": ["summary", "findings"],
          "additionalProperties": false
        }
      ]
    },
    "target": { "type": ["string", "null"] },
    "reply_to": { "anyOf": [{ "type": "null" }, { "type": "array", "items": { "type": "string" } }] }
  },
  "required": ["text", "stance", "proposal", "target", "reply_to"],
  "additionalProperties": false
}
